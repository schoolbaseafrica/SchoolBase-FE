#!/usr/bin/env sh
set -e

# Check only staged files. A commit hook must not rewrite or stage other work.
git diff --cached --name-only --diff-filter=ACM -z |
  xargs -0 -r pnpm exec prettier --check --ignore-unknown

git diff --cached --name-only --diff-filter=ACM -z -- \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' |
  xargs -0 -r pnpm exec eslint
pnpm run check-types
